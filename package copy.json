{
  "name": "quantum-hr-notify-app",
  "version": "1.0.0",
  "type": "module",
  "description": "QuantumHR - Notify App",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "electron-start": "electron .",
    "build": "vite build && electron-builder",
    "clean": "rimraf dist"
  },
  "author": "Ceyapps Global Solutions",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.5",
    "@mui/material": "^5.16.5",
    "auto-launch": "^5.0.6",
    "axios": "^1.7.4",
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "rimraf": "^5.0.9",
    "vite": "^5.4.1",
    "prop-types": "^15.8.1"
  },
  "build": {
    "appId": "com.quantumhr.app",
    "productName": "QuantumHRApp",
    "asar": true,
    "compression": "maximum",
    "files": ["dist/**/*", "src/main/**/*", "public/**/*"],
    "extraResources": [
      {
        "from": "public/assets/",
        "to": "assets/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/assets/images/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/assets/images/icon.icns",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "icon": "public/assets/images/icon.icns",
      "title": "${productName} ${version}"
    }
  }
}
